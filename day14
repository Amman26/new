    data = {
        "name": "Amman",
        "country": "India",
        "city": "Delhi",
        "card": "123456789",
        "month": "May",
        "year": "2026"
    }

    modal.fill_purchase_form(data)

    modal.click_purchase()

    assert "Thank you for your purchase!" in cart.get_success_message()   
      

