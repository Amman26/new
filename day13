from selenium.webdriver.support import expected_conditions as EC

@when('I apply for exactly one day of leave')
def step_impl(context):
    # Store the Initial Leave Balance
    initial_balance_text = context.driver.find_element(By.ID, "leaveBalance").text
    context.initial_balance = int(initial_balance_text)
    
    # Implement actual leave application clicking logic here

@then('I capture the success toast message')
def step_impl(context):
    wait = WebDriverWait(context.driver, 10)
    success_toast = wait.until(EC.visibility_of_element_located((By.CSS_SELECTOR, ".oxd-toast-content--success")))
    context.success_message = success_toast.text

@then('exactly one day of leave should be deducted')
def step_impl(context):
    # Compare against Final Leave Balance
    final_balance_text = context.driver.find_element(By.ID, "leaveBalance").text
    final_balance = int(final_balance_text)
    
    assert context.initial_balance - final_balance == 1, f"Expected 1 day deducted, got {context.initial_balance - final_balance}"


