from selenium import webdriver
import pytest
from pages.login_page import LoginPage


# Data Provider
@pytest.mark.parametrize(
    "username_to_check",
    [
        ("Admin"),
        ("Paul Collings"),
        ("InvalidUser")
    ]
)
def test_verify_user(username_to_check):

    driver = webdriver.Chrome()

    driver.maximize_window()

    login_page = LoginPage(driver)

    login_page.open_url()

    admin_page = login_page.login(
        "Admin",
        "admin123"
    )

    admin_page.open_admin_page()

    user_exists = admin_page.verify_user_exists(
        username_to_check
    )

    print(
        f"Checking User: {username_to_check}"
    )

    print(
        f"Exists: {user_exists}"
    )

    driver.quit()

